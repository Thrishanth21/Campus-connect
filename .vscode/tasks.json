{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Campus Connect API",
			"type": "shell",
			"command": ".\\venv\\Scripts\\python.exe",
			"args": [
				"app.py"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run Campus Connect Frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1",
				"--port",
				"3000",
				"--strictPort"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}